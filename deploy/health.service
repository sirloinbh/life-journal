# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Reviews & Diary health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/life-journal
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/life-journal/deploy/notify.sh /tmp/journal-notify.sh && exec /bin/bash /tmp/journal-notify.sh health'
TimeoutStartSec=2min
