# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=감상문·일기장 health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/life-journal
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/life-journal/deploy/notify.sh /tmp/journal-notify.sh && exec /bin/bash /tmp/journal-notify.sh health'
TimeoutStartSec=2min
