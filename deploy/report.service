# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Reviews & Diary daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/life-journal
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/life-journal/deploy/report.sh /tmp/journal-report.sh && exec /bin/bash /tmp/journal-report.sh'
TimeoutStartSec=5min
