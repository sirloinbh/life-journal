# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Reviews & Diary weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/life-journal
ExecStart=/bin/bash -c 'cp /opt/life-journal/deploy/backup.sh /tmp/journal-restore-check.sh && exec /bin/bash /tmp/journal-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
