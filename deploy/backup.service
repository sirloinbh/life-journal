# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Reviews & Diary daily database dump (and S3 copy when configured)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/life-journal
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/life-journal/deploy/backup.sh /tmp/journal-backup.sh && exec /bin/bash /tmp/journal-backup.sh dump'
TimeoutStartSec=30min
Nice=10
