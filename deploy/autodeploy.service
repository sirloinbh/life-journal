# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=감상문·일기장 pull-based deployment of origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/life-journal
# Copied first: the deploy checks out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/life-journal/deploy/autodeploy.sh /tmp/journal-autodeploy.sh && exec /bin/bash /tmp/journal-autodeploy.sh'
TimeoutStartSec=45min
Nice=10
