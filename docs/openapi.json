              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "ItemInput": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "reading",
              "screen",
              "stage",
              "drink",
              "travel",
              "coffee"
            ]
          },
          "subtype": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "default": "wishlist",
            "type": "string",
            "enum": [
              "wishlist",
              "done"
            ]
          },
          "costKrw": {
            "type": [
              "number",
              "null"
            ]
          },
          "plannedDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "completedDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "subRatings": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "review": {
            "type": [
              "string",
              "null"
            ]
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "category",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
