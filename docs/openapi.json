  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "English error message"
          }
        },
        "required": [
          "error"
        ]
      },
      "ItemPatch": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "reading",
              "screen",
              "stage",
              "drink",
              "travel",
              "coffee"
            ]
          },
          "subtype": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "wishlist",
              "done"
            ]
          },
          "costKrw": {
            "type": [
              "number",
              "null"
            ]
          },
          "plannedDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "completedDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "subRatings": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
