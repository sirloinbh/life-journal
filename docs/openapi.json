              "screen",
              "stage",
              "drink",
              "travel",
              "coffee"
            ]
          },
          "subtype": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
