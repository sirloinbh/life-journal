POSTGRES_DB=journal
POSTGRES_USER=journal
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://journal:change-this-local-password@localhost:15404/journal
PORT=3104
# Optional locally. Set it to run behind the shared sign-in (compose sets http://shared-auth-api:3110).
# AUTH_INTERNAL_URL=http://localhost:3110
# Without AUTH_INTERNAL_URL the host API refuses to start unless this says the run is local. It then runs
# without sign-in and listens on 127.0.0.1 only (#141). compose does not pass it to the container.
AUTH_DISABLED=1
# shared-ai's Ed25519 public key (PEM, one line with \n escapes). Set: the API serves its AI tools at
# /internal/tools; empty: no tools. The server deploy reads it from SSM. @secret @ssm=/sirloinbh/shared/ai-tools-public-key
AI_TOOLS_PUBLIC_KEY=
